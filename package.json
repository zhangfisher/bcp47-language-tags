    },
    "./es": {
      "types": "./dist/es.d.ts",
      "require": "./dist/es.js",
      "import": "./dist/es.mjs"
    },
    "./ar": {
      "types": "./dist/ar.d.ts",
      "require": "./dist/ar.js",
      "import": "./dist/ar.mjs"
    },
    "./pt": {
      "types": "./dist/pt.d.ts",
      "require": "./dist/pt.js",
