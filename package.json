    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "require": "./dist/flags.js",
      "import": "./dist/flags.mjs"
    },
    "./flags/*": {
      "import": "./dist/flags/*",
      "require": "./dist/flags/*",
      "default": "./dist/flags/*"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.js",
      "import": "./dist/utils/index.mjs"
    }
