  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "release": "bun run build && changeset version && changeset publish",
    "only-release": "bun run build && npm publish"
  },
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
